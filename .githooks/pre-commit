#!/bin/sh
# Tracked in the repo and activated by `core.hooksPath`, which `npm run hooks`
# sets. `.git/hooks` is not version-controlled, so a hook that lives only there is
# a hook that exists on one machine and silently protects nothing on any other.
#
# Fast enough to sit in front of every commit: ~10s, almost all of it three
# benchmark runs. Skip it deliberately with `git commit --no-verify` when you mean
# to — a hook nobody can bypass is a hook people delete.
set -e

# Secrets first: it is instant, and it is the one failure that cannot be undone by
# a follow-up commit. Once a credential is pushed it is public whatever happens next.
echo "pre-commit: secrets"
node tools/check-secrets.mjs

# Personal details second, and for the same reason: this repo is public and is
# developed against private work, so the material at hand is the material most
# likely to leak. It has: dollar figures in commit messages, private project names
# across sixty places, and 222MB of build output carrying an absolute path.
echo "pre-commit: personal details"
node tools/check-personal.mjs

echo "pre-commit: perf budget"
node tools/check-perf.mjs

echo "pre-commit: spelling"
node tools/check-spelling.mjs

echo "pre-commit: types and tests"
npm run --silent check:types
npm test --silent >/dev/null
