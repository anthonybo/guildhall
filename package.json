{
	"name": "guildhall",
	"version": "0.2.8",
	"private": true,
	"type": "module",
	"description": "A pixel town of every live Claude Code session, in the terminal",
	"bin": {
		"guildhall": "bin/guildhall"
	},
	"scripts": {
		"start": "npm run --silent build && node dist/main.mjs",
		"build": "esbuild src/main.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/main.mjs --log-level=error && esbuild web/app.ts --bundle --format=esm --target=es2022 --outfile=web/app.js --log-level=error",
		"release": "npm run --silent docs && git add -A docs && (git diff --cached --quiet || git commit -m \"Refresh the documentation images\") && npm run check && npm version ${npm_config_level:-patch} -m \"Release v%s\" && git push --follow-tags",
		"dev": "tsx src/main.ts",
		"once": "tsx src/main.ts --once",
		"bench": "tsx src/main.ts --bench",
		"check": "npm run check:types && npm test && npm run check:docs",
		"check:types": "tsc --noEmit",
		"test": "node --import tsx --test \"src/**/*.test.ts\"",
		"format": "prettier --write .",
		"docs": "sh tools/make-docs-images.sh",
		"check:docs": "sh tools/check-docs-images.sh"
	},
	"dependencies": {
		"ink": "^7.1.1",
		"react": "^19.2.8",
		"string-width": "^8.1.0"
	},
	"devDependencies": {
		"@types/node": "^26.1.2",
		"@types/react": "^19.2.17",
		"prettier": "^3.4.2",
		"esbuild": "^0.25.0",
		"tsx": "^4.23.1",
		"typescript": "^6.0.3"
	}
}
