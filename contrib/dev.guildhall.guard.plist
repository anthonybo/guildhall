<?xml version="1.0" encoding="UTF-8"?>
<!--
  Runs `guildhall --guard` at login: holds sleep off while a Claude Code session
  is working, draws nothing.

  Install it with the same code path that installs the other two, so the paths
  below are substituted rather than hand-edited:
    sh tools/install-mac.sh --guard

  To stop it:
    launchctl bootout gui/$(id -u)/dev.guildhall.guard

  You do not want this AND --headless: both hold sleep off, and the headless
  service also serves the browser view. This one is for a machine that should
  stay awake for its sessions without serving anything.

  KeepAlive restarts it if it ever dies, which matters — a guard that quit
  silently would look exactly like a guard that is working.
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>dev.guildhall.guard</string>

	<key>ProgramArguments</key>
	<array>
		<string>/CHANGEME-NODE</string>
		<string>/Users/CHANGEME/projects/guildhall/dist/main.mjs</string>
		<string>--guard</string>
	</array>

	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>

	<!--
	  ~/Library/Logs, not /tmp, and for this job it matters more than for the others:
	  `--guard` logs "holding sleep off — <project>, <project>" on every transition,
	  so a world-readable log here is a timestamped list of what you work on,
	  readable by any local user. Measured: ~/Library and ~/Library/Logs are 0700
	  while /tmp is world-writable with files at 0644. A symlink planted at the /tmp
	  path would also have launchd — running as you — truncate a file of its choosing.
	-->
	<key>StandardOutPath</key>
	<string>/Users/CHANGEME/Library/Logs/guildhall-guard.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/CHANGEME/Library/Logs/guildhall-guard.log</string>
</dict>
</plist>
